<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  LaunchAgent template for starting awase at login.
  Replace USERNAME with your account name (the README install command does
  this with sed) and install to ~/Library/LaunchAgents/.
  Adding Awase.app to System Settings > General > Login Items works as well;
  use only one of the two.

  Logs go to a per-user directory instead of the shared /tmp: a fixed name in
  a world-writable directory could be pre-created or symlinked by another
  local user (log exposure / symlink append).
-->
<dict>
	<key>Label</key>
	<string>com.github.cuzic.awase</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Applications/Awase.app/Contents/MacOS/awase</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<!-- Restart on crash, but stay stopped when quit from the menu (exit 0) -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>StandardOutPath</key>
	<string>/Users/USERNAME/Library/Logs/Awase/awase.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/USERNAME/Library/Logs/Awase/awase.log</string>
</dict>
</plist>
