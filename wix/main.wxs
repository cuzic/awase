<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="awase"
           Language="1041"
           Version="$(var.Version)"
           Manufacturer="cuzic"
           UpgradeCode="7A8B9C0D-1234-5678-9ABC-DEF012345678">
    <Package InstallerVersion="200" Compressed="yes" InstallScope="perUser" />
    <!-- Schedule="afterInstallExecute": 既定値 afterInstallValidate のままだと
         新バージョンのファイルを配置する前に旧バージョンを完全アンインストール
         してしまい、ConfigFile/NicolaYab の NeverOverwrite="yes" が保護対象
         （ファイルではなく HKCU レジストリ値）ごと消えて無力化する
         （ADR-099 F1、決定0）。afterInstallExecute にすると新バージョンの
         コンポーネント登録が先に走るため、GUID が不変なコンポーネントは
         「新製品からも参照される」状態になり、続く旧製品削除処理で消されない。 -->
    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed."
                  Schedule="afterInstallExecute" />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/cuzic/awase" />
    <Property Id="ARPHELPLINK" Value="https://github.com/cuzic/awase/issues" />
    <Property Id="ARPCONTACT" Value="cuzic" />
    <Property Id="ARPCOMMENTS" Value="A simultaneous-keystroke keyboard remapper for NICOLA thumb shift and beyond" />

    <!-- awase.exe / awase-settings.exe は MSVC ターゲットで動的リンクされており、
         Microsoft Visual C++ 2015-2022 再頒布可能パッケージ (vcruntime140.dll) が
         別途必要。未インストール環境ではこのチェックが無いと、MSI インストール
         自体は成功したのに初回起動時に OS の分かりにくいダイアログ
         （「vcruntime140.dll が見つからないため、このプログラムを開始できません」）
         で失敗する。インストール時点で検出し、対処方法込みのメッセージで
         セットアップを中止させる。
         Message は非 ASCII 文字を含めない（既存の DowngradeErrorMessage も
         英語）。日本語を含めると MSI データベースの既定コードページ(1252、
         西欧文字のみ)で light.exe が LGHT0311 を出す。Codepage 属性を
         932(Shift_JIS)/UTF-8 に変更しても実測で解消しなかった（原因未特定）
         ため、確実な回避策としてメッセージ自体を英語にする。 -->
    <Property Id="VCRUNTIME140FOUND">
      <DirectorySearch Id="System64FolderSearch" Path="[System64Folder]">
        <FileSearch Id="VcRuntime140Search" Name="vcruntime140.dll" />
      </DirectorySearch>
    </Property>

    <Condition Message="awase requires the Microsoft Visual C++ 2015-2022 Redistributable (x64). Download and install it from https://aka.ms/vs/17/release/vc_redist.x64.exe, then run this setup again.">
      <![CDATA[Installed OR VCRUNTIME140FOUND]]>
    </Condition>

    <!-- opengl32.dll の存在チェックはインストール時点では行わない。
         awase-settings.exe（設定画面）は起動時に Glow(OpenGL) が使えなければ
         wgpu(Direct3D 12 の WARP ソフトウェアラスタライザ)へ自動フォールバック
         する（crates/awase-settings/src/startup_failure.rs::run_with_fallback）。
         この経路は opengl32.dll に一切依存しないため、opengl32.dll が無い
         環境でもアプリ自体は正常に動作しうる。インストール時点で
         opengl32.dll の有無を条件にブロックすると、その環境でも動くはずの
         wgpu フォールバックを試す機会そのものを奪ってしまうため、意図的に
         チェックを設けていない（一度追加したが、wgpu フォールバック実装後に
         矛盾すると判断し撤去した）。 -->

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="INSTALLDIR" Name="awase">
          <Directory Id="LayoutDir" Name="layout" />
          <Directory Id="DataDir" Name="data" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="awase" />
      </Directory>
    </Directory>

    <!-- perUser インストールでは File を KeyPath にできない（ICE38）。
         各コンポーネントは HKCU レジストリキーを KeyPath にする。
         また ICE64 対策として各ディレクトリに RemoveFolder を追加する。 -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLDIR">
      <Component Id="MainExe" Guid="FEE4643D-BD1C-4FBA-A6F0-3422691909C5">
        <File Id="AwaseExe" Source="dist\awase.exe" />
        <RegistryValue Root="HKCU" Key="Software\awase" Name="MainExe"
                       Type="string" Value="" KeyPath="yes" />
        <RegistryValue Root="HKCU"
                       Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="awase"
                       Type="string"
                       Value="[INSTALLDIR]awase.exe" />
        <RemoveFolder Id="RemoveInstallDir" Directory="INSTALLDIR" On="uninstall" />
      </Component>
      <Component Id="SettingsExe" Guid="83280E86-7973-43A3-84E9-A4B51E47751B">
        <File Source="dist\awase-settings.exe" />
        <RegistryValue Root="HKCU" Key="Software\awase" Name="SettingsExe"
                       Type="string" Value="" KeyPath="yes" />
      </Component>
      <!-- この GUID を変更すると ADR-099 決定0 が意図するアップグレード時の
           ユーザー設定保護が壊れる。
           crates/awase-windows/tests/wix_installer_guard.rs（決定8）参照。 -->
      <Component Id="ConfigFile" Guid="57E95F1F-4785-40B7-A4E7-16613080C938" NeverOverwrite="yes">
        <File Source="dist\config.toml" />
        <RegistryValue Root="HKCU" Key="Software\awase" Name="ConfigFile"
                       Type="string" Value="" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Layout files -->
    <ComponentGroup Id="LayoutFiles" Directory="LayoutDir">
      <!-- NeverOverwrite="yes": layout/nicola.yab は awase-settings の配列編集
           タブがその場で上書き保存するユーザーデータ（ADR-099 F3訂正）。
           Schedule="afterInstallExecute" だけでは通常アップグレード時の
           InstallFiles による上書きは防げない（防げるのは旧製品削除に
           よる消失のみ）ため、ConfigFile と同様にここでも必要（ADR-099 決定0
           round2 MF-1）。
           以下の GUID を変更すると、この保護（新旧バージョン間で同一
           コンポーネントとして扱われることによるユーザーデータ保持）が
           構造的に壊れる。crates/awase-windows/tests/wix_installer_guard.rs
           （ADR-099 決定8）がこの GUID・NeverOverwrite・Schedule の3点を
           固定しており、変更する場合はテストごと意図的に更新すること。 -->
      <Component Id="NicolaYab" Guid="9690990E-0D11-425B-B60C-AF23D5E87226" NeverOverwrite="yes">
        <File Source="dist\layout\nicola.yab" />
        <RegistryValue Root="HKCU" Key="Software\awase" Name="NicolaYab"
                       Type="string" Value="" KeyPath="yes" />
        <RemoveFolder Id="RemoveLayoutDir" Directory="LayoutDir" On="uninstall" />
      </Component>
      <!-- layout/nicola_keytop.yab（2026-08-31追加、新規インストールの既定）は
           NicolaYab とは別物: ユーザーがその場で編集保存する対象ではなく、
           新規インストール時に一度だけ配置される雛形のため NeverOverwrite は
           付けない（ADR-099 決定2の DataFiles と同じ扱い）。 -->
      <Component Id="NicolaKeytopYab" Guid="5B75B3B2-A53D-493E-BB62-81AE2B17D8ED">
        <File Source="dist\layout\nicola_keytop.yab" />
        <RegistryValue Root="HKCU" Key="Software\awase" Name="NicolaKeytopYab"
                       Type="string" Value="" KeyPath="yes" />
      </Component>
      <!-- layout/nicola_us.yab・layout/nicola_f.yab（2026-08-31追加、Opus
           レビュー指摘: README.md/README.en.mdがdefault_layoutの切り替え先
           として案内しているのに、MSIには元々どちらも同梱されておらず、
           案内通りに変更すると存在しないファイルへ無言でフォールバック
           していた）。NicolaYab と同じくユーザーが配列編集タブでその場編集
           しうるデータのため NeverOverwrite="yes" にする（DataFiles とは
           異なり、これらは default_layout の切り替え先として README が
           明示的に案内するファイルであり、GUI 編集の対象になりうる）。 -->
      <Component Id="NicolaUsYab" Guid="48AA34CA-3723-4B7D-B624-6E0E9C29032C" NeverOverwrite="yes">
        <File Source="dist\layout\nicola_us.yab" />
        <RegistryValue Root="HKCU" Key="Software\awase" Name="NicolaUsYab"
                       Type="string" Value="" KeyPath="yes" />
      </Component>
      <Component Id="NicolaFYab" Guid="523F3EB9-8E27-4312-A6D1-822D1BF7785F" NeverOverwrite="yes">
        <File Source="dist\layout\nicola_f.yab" />
        <RegistryValue Root="HKCU" Key="Software\awase" Name="NicolaFYab"
                       Type="string" Value="" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Data files（ユーザーが編集する手段を持たないプログラム資産のため
         NeverOverwrite は付けない。ADR-099 決定2参照） -->
    <ComponentGroup Id="DataFiles" Directory="DataDir">
      <Component Id="NgramData" Guid="DCF4BA85-03F3-4EC7-BF17-D870682FFF5E">
        <File Source="dist\data\ngram_hiragana.csv.gz" />
        <RegistryValue Root="HKCU" Key="Software\awase" Name="NgramData"
                       Type="string" Value="" KeyPath="yes" />
        <RemoveFolder Id="RemoveDataDir" Directory="DataDir" On="uninstall" />
      </Component>
    </ComponentGroup>

    <!-- Start Menu shortcuts -->
    <ComponentGroup Id="Shortcuts" Directory="ApplicationProgramsFolder">
      <Component Id="AppShortcut" Guid="4C391571-272A-41C6-8F88-043A88758E89">
        <Shortcut Id="AwaseShortcut" Name="awase" Target="[INSTALLDIR]awase.exe" WorkingDirectory="INSTALLDIR" />
        <Shortcut Id="SettingsShortcut" Name="awase Settings" Target="[INSTALLDIR]awase-settings.exe" WorkingDirectory="INSTALLDIR" />
        <!-- 「アプリと機能」のARPエントリはOS/実行環境側の要因で登録されないことがある
             （実機検証: RegisterProduct/PublishProductは成功するがUninstallキーが作成されない
             ケースを確認、最小構成のMSIでも再現）。ARPの表示有無に依存しない
             アンインストール手段として、msiexecを直接呼ぶショートカットを用意する。 -->
        <Shortcut Id="UninstallShortcut" Name="Uninstall awase"
                  Description="Uninstalls awase"
                  Target="[System64Folder]msiexec.exe"
                  Arguments="/x [ProductCode]" />
        <RemoveFolder Id="RemoveAppFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\awase" Name="installed"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="ProductFeature" Title="awase" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="LayoutFiles" />
      <ComponentGroupRef Id="DataFiles" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>

    <!-- インストール完了直後に awase.exe を起動する。
         perUser インストールなので昇格・偽装は不要（現在のユーザーコンテキストでそのまま実行される）。
         Return="asyncNoWait" によりインストーラは awase.exe の終了を待たずに完了する
         （常駐アプリのため待つと永久にハングする）。
         "NOT Installed" は「このプロダクトが以前からインストール済みでない」場合のみ真になる
         MSI 標準プロパティで、新規インストール時のみ起動し、修復・アンインストール時には起動しない。 -->
    <CustomAction Id="LaunchApplication"
                  FileKey="AwaseExe"
                  ExeCommand=""
                  Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="LaunchApplication" After="InstallFinalize">NOT Installed</Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
