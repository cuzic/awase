{
  "_comment": "ADR-257 決定3〜5・10。期待値(expect)は手書きで、ここだけが正。生成物(バイト列)は scenario-maps.json(Rust の golden が検証)。数値は10進。スキャンコードは、E0 付きのキーは ext=1 で別に持つ(レジストリのエントリでは 0xE0xx の1つの値)。",
  "control_keys": [
    { "name": "A", "vk": 65, "sc": 30, "ext": 0, "letter": true, "note": "0x41 / 0x1E" },
    { "name": "S", "vk": 83, "sc": 31, "ext": 0, "letter": true, "note": "0x53 / 0x1F" },
    { "name": "D", "vk": 68, "sc": 32, "ext": 0, "letter": true, "note": "0x44 / 0x20" },
    { "name": "B", "vk": 66, "sc": 48, "ext": 0, "letter": true, "note": "0x42 / 0x30" },
    { "name": "Caps", "vk": 20, "sc": 58, "ext": 0, "note": "VK_CAPITAL / 0x3A" },
    { "name": "LCtrl", "vk": 162, "sc": 29, "ext": 0, "note": "VK_LCONTROL / 0x1D" },
    { "name": "LAlt", "vk": 164, "sc": 56, "ext": 0, "note": "VK_LMENU / 0x38" },
    { "name": "RAlt", "vk": 165, "sc": 56, "ext": 1, "note": "VK_RMENU / E0 0x38" },
    { "name": "Space", "vk": 32, "sc": 57, "ext": 0, "note": "0x39" },
    { "name": "Muhenkan", "vk": 0, "sc": 123, "ext": 0, "scan": true, "note": "0x7B。PressKey の VK では送れないので TypeScancodes" },
    { "name": "Henkan", "vk": 0, "sc": 121, "ext": 0, "scan": true, "note": "0x79" },
    { "name": "Kana", "vk": 0, "sc": 112, "ext": 0, "scan": true, "note": "0x70" }
  ],
  "scenarios": [
    { "name": "pair", "kind": "verify", "source": "raw", "entries": [[30, 48], [48, 30]],
      "press": ["A", "B"], "expect": ["B", "A"], "note": "A⇄B(許可リスト外なので手書きのバイト列)" },
    { "name": "cycle", "kind": "verify", "source": "raw", "entries": [[30, 31], [31, 32], [32, 30]],
      "press": ["A", "S", "D"], "expect": ["S", "D", "A"], "note": "A の位置は S を、S の位置は D を、D の位置は A を出す(1回だけの適用)" },
    { "name": "cycle-reverse", "kind": "verify", "source": "raw", "entries": [[30, 32], [32, 31], [31, 30]],
      "press": ["A", "S", "D"], "expect": ["D", "A", "S"], "note": "逆向き" },
    { "name": "caps-extra-ctrl", "kind": "verify", "source": "decide",
      "request": { "existing": [], "pairs": [], "cycles": [], "caps_extra_ctrl": true, "allow_displace": true },
      "press": ["Caps"], "expect": ["LCtrl"], "note": "Caps 追加 Ctrl: Caps の位置が左 Ctrl を出す" },
    { "name": "ctrl-caps-swap", "kind": "verify", "source": "decide",
      "request": { "existing": [], "pairs": [[58, 29]], "cycles": [], "caps_extra_ctrl": false, "allow_displace": true },
      "press": ["Caps", "LCtrl"], "expect": ["LCtrl", "Caps"] },
    { "name": "space-henkan-swap", "kind": "verify", "source": "decide",
      "request": { "existing": [], "pairs": [[57, 121]], "cycles": [], "caps_extra_ctrl": false, "allow_displace": true },
      "press": ["Space", "Henkan"], "expect": ["Henkan", "Space"], "note": "スペース⇄変換(ADR-255 の用途に近い)" },
    { "name": "alt-left-right-swap", "kind": "verify", "source": "decide",
      "request": { "existing": [], "pairs": [[56, 57400]], "cycles": [], "caps_extra_ctrl": false, "allow_displace": true },
      "press": ["LAlt", "RAlt"], "expect": ["RAlt", "LAlt"], "note": "拡張ビットだけが違う左右の Alt の入れ替え(E0 の扱い)" },
    { "name": "cycle3-jis", "kind": "verify", "source": "decide",
      "request": { "existing": [], "pairs": [], "cycles": [[112, 123, 121]], "caps_extra_ctrl": false, "allow_displace": true },
      "press": ["Kana", "Muhenkan", "Henkan"], "expect": ["Muhenkan", "Henkan", "Kana"], "note": "かな→無変換→変換→かな(循環。位置→機能の向き)" },
    { "name": "preserve-foreign", "kind": "verify", "source": "decide",
      "request": { "existing": [[30, 48]], "pairs": [[123, 121]], "cycles": [], "caps_extra_ctrl": false, "allow_displace": true },
      "press": ["A", "Muhenkan", "Henkan"], "expect": ["B", "Henkan", "Muhenkan"], "note": "他ツールの A→B を保持したまま、無変換⇄変換を足す" },
    { "name": "pair-and-caps-extra", "kind": "verify", "source": "decide",
      "request": { "existing": [], "pairs": [[123, 121]], "cycles": [], "caps_extra_ctrl": true, "allow_displace": true },
      "press": ["Muhenkan", "Henkan", "Caps"], "expect": ["Henkan", "Muhenkan", "LCtrl"], "note": "ペアと Caps 追加 Ctrl の併用" },
    { "name": "from-duplicate", "kind": "observe", "source": "raw", "entries": [[30, 31], [30, 32]],
      "press": ["A"], "expect": [], "note": "同じ from が2つ。A の位置が S(先勝ち)か D(後勝ち)かを記録する。ADR-230 の未確認。結果を ADR に書いたら verify に昇格" }
  ]
}
