{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/architecture-guard-on-edit.sh",
            "async": true,
            "asyncRewake": true,
            "rewakeMessage": "architecture_guard test failed after your last edit:\n",
            "rewakeSummary": "architecture_guard test failure",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
