# golden ファイルは Rust コード側が生成する `actual`（常に \n）とバイト単位で比較される。
# Windows ランナーの git 既定 core.autocrlf=true によるチェックアウト時 CRLF 変換を防ぐため、
# 改行コードを LF に固定する。
crates/awase-windows/tests/golden/** text eol=lf

# Cargo.lock は生成ファイルであり、行ベースの3-wayマージは checksum の整合性を
# 崩した「見た目は成功したが壊れたロックファイル」を無言で作りうる。マージを
# 常に手動対応(コンフリクトマーカーを見たら `cargo generate-lockfile` で作り直す)
# にするため merge driver を無効化する。
Cargo.lock merge=binary
