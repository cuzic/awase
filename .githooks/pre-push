#!/usr/bin/env bash
# pre-push: awase-windows を Windows ターゲットでクリーンチェックする
#
# pre-commit の cargo xwin check はキャッシュを使うため、Linux クロスコンパイルが
# 誤って通過した場合にキャッシュ汚染が起きる。pre-push では awase-windows の
# xwin キャッシュをクリアしてから再チェックすることでこれを防ぐ。
set -euo pipefail

# git が渡す ref リストは stdin から一度だけ読める。以下の advisory チェックと
# 既存の xwin チェックの両方で使えるよう、先に変数へ退避する。
push_refs="$(cat)"

# --- [advisory] fix-requires-evidence（非ブロッキング警告） -------------------
# 再発ファミリー（warmup/focus/belief/conv/キー選択）該当ファイルが変更されている
# のに tests/ か docs/known-bugs.md に差分が無ければ、テスト/記録の追加を促す。
# 参照: .claude/rules/fix-requires-evidence.md
warn_if_missing_evidence() {
    local refs="$1"
    local changed="" _lref lsha _rref rsha
    while IFS=' ' read -r _lref lsha _rref rsha; do
        if [ -z "${lsha:-}" ]; then continue; fi
        if [ "$lsha" = "0000000000000000000000000000000000000000" ]; then continue; fi
        if [ "${rsha:-}" = "0000000000000000000000000000000000000000" ]; then continue; fi
        if [ -z "${rsha:-}" ]; then continue; fi
        changed+="$(git diff --name-only "${rsha}..${lsha}" 2>/dev/null || true)"$'\n'
    done <<< "$refs"

    # ADR-158 TC1（2026-09-09）: 追跡下の.githooks/pre-pushと実行される
    # .git/hooks/pre-push（未追跡）が双方向に乖離していたため、両者の正規表現の
    # 和集合をここに反映した。runtime/(message_handlers|outbox)は旧.git/hooks側
    # のみが持っていた対象、runtime/(transport|ime_refresh)は本ファイル側のみが
    # 持っていた対象、input_defer.rsは旧.git/hooks側のみ。runtime/modは
    # fix-requires-evidence.mdの「IME actuation合流点」表が挙げる5つ目の入口
    # （reassert_explicit_physical_key）で、どちらのファイルにも含まれていな
    # かったため新規追加した。
    local target='(crates/awase-windows/src/(output/|tsf/|focus/|runtime/(ime_coordinator|focus_tracking|key_pipeline|conv_actuation|open_chain|executor|transport|ime_refresh|message_handlers|outbox|mod)\.rs|state/(ime|conv_mode|observation_store)|ime_controller\.rs|ime\.rs|input_defer\.rs|platform\.rs|tuning\.rs)|src/engine/nicola_fsm\.rs)'
    # 2026-09-11: docs/known-bugs.md を docs/known-bugs/*.md に分割したため、
    # エビデンス対象パスをディレクトリ側に変更（旧ファイルは以後リダイレクト
    # スタブのみで差分が発生しない）。
    local evidence='(crates/awase-windows/tests/|src/engine/tests\.rs|docs/known-bugs/)'

    if printf '%s' "$changed" | grep -qE "$target"; then
        if ! printf '%s' "$changed" | grep -qE "$evidence"; then
            echo "[pre-push][warn] awase-windows の再発ファミリー該当ファイルが変更されていますが、"
            echo "                 tests/ にも docs/known-bugs/ にも差分がありません。"
            echo "                 golden/ジャーナルリプレイの追加、または docs/known-bugs/ への新規BUGファイル追記を検討してください。"
            echo "                 （.claude/rules/fix-requires-evidence.md 参照 / 警告のみ・push はブロックしません）"
        fi
    fi
}
warn_if_missing_evidence "$push_refs" || true
# -----------------------------------------------------------------------------

needs_check=false

while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
    # 削除 push (local_sha が all-zeros) はスキップ
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue

    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        # 新規ブランチ: 保守的にチェック実行
        needs_check=true
    elif git diff --name-only "${remote_sha}..${local_sha}" 2>/dev/null \
            | grep -q '^crates/awase-windows/'; then
        needs_check=true
    fi

    $needs_check && break
done <<< "$push_refs"

if ! $needs_check; then
    exit 0
fi

if ! command -v cargo-xwin &>/dev/null; then
    echo "[pre-push] cargo-xwin が見つかりません。skip します（mise run check にフォールバック）。"
    mise run check
    exit $?
fi

echo "[pre-push] awase-windows xwin キャッシュをクリアして再チェック ..."
# awase-windows 自身のキャッシュのみクリア（依存クレートは保持）
cargo clean -p awase-windows --target x86_64-pc-windows-msvc 2>/dev/null || true
# --target は必須（省略禁止）。cargo-xwin は --target が無いと Windows 向けの
# 設定を一切適用せず、素の cargo check（= ホストの x86_64-unknown-linux-gnu 向け）
# にフォールバックする。awase-windows の Windows API 依存は
# [target.'cfg(windows)'.dependencies] にあるため、ホストターゲットでは
# windows crate すら extern されず #[cfg(windows)] 配下が丸ごと未検査になる。
# 上の cargo clean が msvc ターゲットのキャッシュを消しているのに check が
# ホスト向けだと、クリーンチェックの意味自体が消える。
cargo xwin check --target x86_64-pc-windows-msvc -p awase-windows 2>&1
